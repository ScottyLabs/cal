# Public, build-time values only. Next.js inlines NEXT_PUBLIC_* at build time,
# and kennel resolves secrets at deploy time - after the build - so these
# cannot come from OpenBao. The API base URL is the service's own public
# domain, so it is public by design. Everything the Keycloak login needs
# (OIDC_CLIENT_SECRET, SESSION_SECRET, ...) is a runtime secret declared in
# secretspec.toml and read on the server only.
NEXT_PUBLIC_API_URL=https://api.cmucal.com/api
