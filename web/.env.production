# Public, build-time values only. Next.js inlines NEXT_PUBLIC_* at build time,
# and kennel resolves secrets at deploy time - after the build - so these
# cannot come from OpenBao. Both values are public by design: the API base URL
# is the service's own public domain, and a Clerk publishable key is meant to
# ship to the browser. Real secrets (CLERK_SECRET_KEY) stay in secretspec.toml.
NEXT_PUBLIC_API_URL=https://api.cal.scottylabs.org/api
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bmV1dHJhbC1za3lsYXJrLTUzLmNsZXJrLmFjY291bnRzLmRldiQ
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/?welcome=true
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
