# cp web/.env.example web/.env.local, then fill in. Never commit it.

NEXT_PUBLIC_API_URL=http://localhost:8080/api
APP_URL=http://localhost:3000

# Keycloak login through a local Ricochet relay (see docs/getting-started.md).
KEYCLOAK_URL=https://idp.scottylabs.org
KEYCLOAK_REALM=scottylabs
OIDC_CLIENT_ID=cal-dev
OAUTH_RELAY_URL=http://localhost:8090/oauth2/callback

# SECRET. The cal-dev client secret; ask the tech lead.
OIDC_CLIENT_SECRET=

# Any random 32+ characters, e.g. the output of `openssl rand -base64 48`.
SESSION_SECRET=
