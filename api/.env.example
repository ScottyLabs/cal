# cp api/.env.example api/.env.development, then fill in. Never commit it.
# Production gets these from OpenBao (see secretspec.toml).

# SECRET. The shared dev database; ask the tech lead.
SUPABASE_DB_URL=

# PORT=8080

# Google Calendar sync. The redirect registered with Google is on port 5001,
# so set PORT=5001 here and NEXT_PUBLIC_API_URL=http://localhost:5001/api in
# web/.env.local.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5001/api/google/oauth/callback
# OAUTHLIB_INSECURE_TRANSPORT=1

# Scrapers and course agent only. They write straight to Supabase.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# API_BASE_URL=
# OPENROUTER_API_KEY=
# SERPER_API_KEY=
